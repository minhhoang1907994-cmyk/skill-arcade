# Danh sách biến môi trường project dùng, kèm giá trị mặc định.
#
# LƯU Ý: project KHÔNG có gem dotenv, nên file .env sẽ không được tự động nạp.
# Đây là tài liệu tham chiếu — phải export biến ở shell/systemd/Docker env thật:
#   PowerShell: $env:GEMINI_API_KEY = "..."
#   bash:       export GEMINI_API_KEY=...
# Các biến DB đều đã có default trong config/database.yml nên không export cũng chạy được;
# riêng GEMINI_API_KEY không có default và bắt buộc phải export mới dùng được Phase 3.

# Database (khớp với docker-compose.yml)
DB_HOST=127.0.0.1
# 3307 để không đụng MySQL native thường chiếm 3306 trên máy dev
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=skill_arcade
DB_NAME=skill_arcade_development
DB_NAME_TEST=skill_arcade_test

# Gemini API — dùng ở Phase 3 (sinh đề theo lô và chấm Spec Detective).
# Không bao giờ commit giá trị thật, không ghi vào log (spec section 12).
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.6-flash

# Kênh liên hệ hiện trên trang /privacy để người dùng yêu cầu xoá tài khoản (Open Question Q8).
# Chưa set thì trang nói rõ là app chưa công bố kênh liên hệ, không bịa ra địa chỉ.
PRIVACY_CONTACT_EMAIL=<EMAIL_LIEN_HE>
