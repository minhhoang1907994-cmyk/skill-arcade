<h1><%= @game.name %></h1>

<div class="hero-row">
  <%= game_sprite(@game, size: 64, css_class: "sprite--bounce") %>
  <div class="hero-row__bubble"><%= @game.description %></div>
</div>

<div id="intro" class="panel">
  <p>
    Mỗi lượt gồm <strong><%= @game.steps_per_session %> bước</strong>,
    tối đa <strong><%= @game.max_score %> điểm</strong>.
    Điểm cao nhất của bạn: <strong><%= current_user.best_score_for(@game) %></strong>.
  </p>

  <% if @game.language_scoped? %>
    <p class="score-label" style="margin-top:8px">Chọn ngôn ngữ lập trình</p>
    <% if @languages.any? %>
      <div class="chips" role="radiogroup" aria-label="Ngôn ngữ lập trình">
        <% @languages.each_with_index do |language, index| %>
          <label>
            <input type="radio" name="language" value="<%= language %>"
                   <%= "checked" if index.zero? %>>
            <span><%= language %></span>
          </label>
        <% end %>
      </div>
      <p class="muted small" style="margin-top:10px">
        Cả lượt chơi chỉ gồm câu hỏi thuộc ngôn ngữ bạn chọn.
      </p>
    <% else %>
      <p class="muted small">
        Chưa ngôn ngữ nào đủ <%= @game.questions_per_session %> câu hỏi cho một lượt.
      </p>
    <% end %>
  <% end %>

  <%# Lý do duy nhất không chơi được, biết trước ở server: chưa đủ câu cho ngôn ngữ nào. %>
  <% cannot_start = @game.language_scoped? && @languages.empty? %>
  <div class="actions">
    <button id="start-btn" type="button" class="btn--primary"
            <%= "disabled" if cannot_start %>>
      Bắt đầu lượt mới
    </button>
    <%= link_to "Quay lại", games_path, class: "btn" %>
  </div>
</div>

<div id="play" class="panel" hidden>
  <div class="score-line">
    <span class="score-label">Bước</span>
    <strong><span id="position">-</span> / <%= @game.steps_per_session %></strong>
    <span class="site-header__spacer"></span>
    <span class="score-label">Điểm</span>
    <span class="score-value" id="score">0</span>
  </div>
  <div class="progress">
    <div class="progress__bar" id="progress-bar" style="width: 0%"></div>
  </div>

  <div id="question"></div>
  <div id="answer-area"></div>

  <div class="actions actions--split">
    <div class="actions">
      <button id="submit-btn" type="button" class="btn--primary">Nộp đáp án</button>
      <button id="next-btn" type="button" class="btn--primary" hidden>Câu tiếp theo</button>
      <button id="report-btn" type="button" class="btn">Báo câu hỏi sai</button>
    </div>
    <button id="abandon-btn" type="button" class="btn btn--danger">Bỏ lượt</button>
  </div>

  <div id="feedback"></div>
</div>

<div id="result" class="panel" hidden>
  <h2 class="panel__title">Kết thúc lượt</h2>
  <%= pixel_sprite(:chest, size: 72, css_class: "sprite--bounce") %>
  <p class="result-score" id="result-score">0</p>
  <p id="result-text" class="muted"></p>
  <div class="actions">
    <button id="replay-btn" type="button" class="btn--primary">Chơi lại</button>
    <%= link_to "Bảng xếp hạng", leaderboards_path(game: @game.slug), class: "btn" %>
    <%= link_to "Danh sách game", games_path, class: "btn" %>
  </div>
</div>

<script type="module">
  const slug = <%= @game.slug.to_json.html_safe %>;
  // Nhãn loại bug lấy từ Question::BUG_HUNT_TYPE_LABELS — một nguồn duy nhất cho cả UI và
  // phần giải thích do server sinh, không khai lại danh sách ở JS.
  const bugTypeLabels = <%= Question::BUG_HUNT_TYPE_LABELS.to_json.html_safe %>;
  const totalSteps = <%= @game.steps_per_session %>;
  const maxScore = <%= @game.max_score %>;
  const csrf = document.querySelector('meta[name="csrf-token"]').content;

  let sessionId = null;
  let step = null;
  let questionId = null;
  let stepShownAt = null;
  // Kết quả của câu vừa nộp, giữ lại cho tới khi người chơi bấm "Câu tiếp theo".
  let pendingResult = null;

  const $ = (id) => document.getElementById(id);

  async function api(path, options = {}) {
    const res = await fetch(path, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        // Bắt buộc: endpoint dùng session cookie nên vẫn chịu CSRF protection (spec §13).
        "X-CSRF-Token": csrf,
        ...(options.headers || {})
      }
    });
    const body = res.status === 204 ? null : await res.json().catch(() => null);
    if (!res.ok) throw Object.assign(new Error("api"), { status: res.status, body });
    return body;
  }

  function showFeedback(text, kind) {
    const el = $("feedback");
    el.className = "feedback feedback--" + kind;
    el.textContent = text;
  }

  function clearFeedback() {
    $("feedback").className = "";
    $("feedback").textContent = "";
  }

  function renderStep(data) {
    step = data.position;
    questionId = data.question_id;
    stepShownAt = Date.now();
    $("position").textContent = step;
    $("progress-bar").style.width = ((step - 1) * 100 / totalSteps) + "%";
    clearFeedback();
    pendingResult = null;
    $("submit-btn").hidden = false;
    $("submit-btn").disabled = false;
    $("next-btn").hidden = true;

    const c = data.content;
    if (slug === "bug_hunt") {
      renderBugHunt(c);
    } else if (slug === "estimate_poker") {
      $("question").innerHTML = "<p><strong>Task:</strong> " + escapeHtml(c.task_description) + "</p>" +
        '<p class="muted small">' + escapeHtml(c.context || "") + "</p>";
      $("answer-area").innerHTML =
        '<div class="form"><div class="field"><label for="hours">Ước lượng (giờ)</label>' +
        '<input id="hours" type="number" min="0.5" step="0.5" autofocus></div></div>';
    } else if (slug === "spec_detective") {
      renderSpecDetective(c);
    } else {
      renderScenario(c);
    }
  }

  function renderBugHunt(c) {
    $("question").innerHTML = "";
    const ol = document.createElement("ol");
    ol.className = "code-lines";
    c.code_lines.forEach((line, i) => {
      const li = document.createElement("li");
      li.textContent = line;
      li.tabIndex = 0;
      li.setAttribute("role", "button");
      li.setAttribute("aria-label", "Dòng " + (i + 1));
      const pick = () => selectLine(i + 1, li);
      li.addEventListener("click", pick);
      // Điều hướng bằng bàn phím — yêu cầu a11y ở spec §15.
      li.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); }
        if (e.key === "ArrowDown") { e.preventDefault(); li.nextElementSibling?.focus(); }
        if (e.key === "ArrowUp") { e.preventDefault(); li.previousElementSibling?.focus(); }
      });
      ol.appendChild(li);
    });
    $("question").appendChild(ol);

    // Loại bug hiện hết ra ngoài dạng thẻ bấm chọn — không dùng dropdown, để người chơi
    // thấy toàn bộ lựa chọn và không vô tình nộp giá trị mặc định. Mỗi thẻ có tên tiếng
    // Việt kèm một dòng gợi ý dấu hiệu nhận biết; slug tiếng Anh không hiện ra vì tự nó
    // không nói lên loại bug là gì.
    $("answer-area").className = "";
    $("answer-area").innerHTML =
      '<p class="score-label">Dòng đã chọn: <span id="chosen-line">chưa chọn</span></p>' +
      '<p class="score-label" style="margin-top:14px">Loại bug</p>' +
      '<div class="bug-types" role="radiogroup" aria-label="Loại bug">' +
      c.bug_types.map((t) => {
        const label = bugTypeLabels[t] || { name: t, hint: "" };
        return '<label><input type="radio" name="bug-type" value="' + escapeHtml(t) + '">' +
          '<span class="bug-type__name">' + escapeHtml(label.name) + "</span>" +
          '<span class="bug-type__hint">' + escapeHtml(label.hint) + "</span></label>";
      }).join("") +
      "</div>";
  }

  // Từng câu của đoạn yêu cầu là một ô tick, số thứ tự trên UI khớp đúng index mà server
  // dùng để chấm (đếm từ 1). Dựng bằng DOM API chứ không nối chuỗi HTML vì nội dung câu do
  // AI sinh — textContent tự escape.
  function renderSpecDetective(c) {
    // Đề soạn TRƯỚC 1.19 chỉ có requirement_text, không có statements/clarifying_options
    // (xem changelog 1.19). Bốc phải đề như vậy thì trước đây forEach ném TypeError và
    // người chơi chỉ thấy màn hình trống. Báo rõ và mời báo câu sai thay vì vỡ im lặng.
    if (!Array.isArray(c.statements) || !Array.isArray(c.clarifying_options)) {
      $("question").innerHTML = "";
      $("answer-area").className = "";
      $("answer-area").innerHTML = "";
      $("submit-btn").disabled = true;
      showFeedback("Câu hỏi này ở định dạng cũ nên chưa chơi được. Bấm “Báo câu hỏi sai” " +
                   "để admin ẩn nó, rồi bỏ lượt và chơi lại.", "bad");
      return;
    }

    $("question").innerHTML = "";
    const intro = document.createElement("p");
    intro.className = "muted small";
    intro.textContent = "Tick những câu bạn cho là còn mơ hồ. Tick sai bị trừ điểm.";
    $("question").appendChild(intro);

    const ol = document.createElement("ol");
    ol.className = "statements";
    c.statements.forEach((text, i) => {
      const li = document.createElement("li");
      const label = document.createElement("label");
      const box = document.createElement("input");
      box.type = "checkbox";
      box.name = "stmt";
      box.value = i + 1;
      const span = document.createElement("span");
      span.textContent = text;
      label.appendChild(box);
      label.appendChild(span);
      li.appendChild(label);
      ol.appendChild(li);
    });
    $("question").appendChild(ol);

    $("answer-area").className = "options";
    $("answer-area").innerHTML =
      '<p class="score-label">Câu hỏi làm rõ nào tốt nhất?</p>' +
      c.clarifying_options.map((o) =>
        '<label><input type="radio" name="opt" value="' + escapeHtml(o.key) + '"> ' +
        escapeHtml(o.label) + "</label>"
      ).join("");
  }

  function renderScenario(c) {
    const node = c.nodes[step - 1];
    $("question").innerHTML = "";
    if (c.initial_logs && step === 1) {
      const log = document.createElement("div");
      log.className = "scenario-log";
      log.textContent = c.initial_logs;
      $("question").appendChild(log);
    }
    const p = document.createElement("p");
    p.innerHTML = "<strong>" + escapeHtml(node.prompt) + "</strong>";
    $("question").appendChild(p);

    $("answer-area").className = "options";
    $("answer-area").innerHTML = node.options
      .map((o) => '<label><input type="radio" name="opt" value="' + o.key + '"> ' +
                  escapeHtml(o.label) + "</label>")
      .join("");
    $("answer-area").dataset.nodeKey = node.key;
  }

  function escapeHtml(s) {
    const d = document.createElement("div");
    d.textContent = s == null ? "" : String(s);
    return d.innerHTML;
  }

  function selectLine(n, li) {
    if (pendingResult) return;
    document.querySelectorAll(".code-lines li").forEach((el) => el.classList.remove("is-selected"));
    li.classList.add("is-selected");
    const chosen = $("chosen-line");
    chosen.textContent = n;
    chosen.dataset.value = n;
  }

  function buildAnswer() {
    if (slug === "bug_hunt") {
      const line = $("chosen-line").dataset.value;
      if (!line) throw new Error("Chọn một dòng code trước");
      const type = document.querySelector('input[name="bug-type"]:checked');
      if (!type) throw new Error("Chọn loại bug");
      return { line: Number(line), bug_type: type.value };
    }
    if (slug === "estimate_poker") {
      const hours = Number($("hours").value);
      if (!hours) throw new Error("Nhập số giờ ước lượng");
      return { hours };
    }
    if (slug === "spec_detective") {
      const picked = Array.from(document.querySelectorAll('input[name="stmt"]:checked'))
        .map((el) => Number(el.value));
      if (!picked.length) throw new Error("Tick ít nhất một câu bạn cho là mơ hồ");
      const opt = document.querySelector('input[name="opt"]:checked');
      if (!opt) throw new Error("Chọn một câu hỏi làm rõ");
      return { statement_indexes: picked, option_key: opt.value };
    }
    const chosen = document.querySelector('input[name="opt"]:checked');
    if (!chosen) throw new Error("Chọn một phương án");
    return { node_key: $("answer-area").dataset.nodeKey, option_key: chosen.value };
  }

  function selectedLanguage() {
    const picked = document.querySelector('input[name="language"]:checked');
    return picked ? picked.value : null;
  }

  $("start-btn").addEventListener("click", async () => {
    $("start-btn").disabled = true;

    let data;
    try {
      const language = selectedLanguage();
      data = await api("/api/v1/games/" + slug + "/sessions", {
        method: "POST",
        body: language ? JSON.stringify({ language }) : undefined
      });
    } catch (e) {
      $("start-btn").disabled = false;
      await appDialog.alert(e.body?.message || "Không bắt đầu được lượt chơi",
                            { title: "Chưa vào được lượt" });
      return;
    }

    // renderStep KHÔNG nằm trong try ở trên. Lượt đã được tạo ở server rồi, nên lỗi
    // dựng giao diện không phải "không bắt đầu được lượt chơi" — gộp hai thứ vào một
    // catch từng làm lỗi đề sai format bị báo thành lỗi API và che mất nguyên nhân.
    sessionId = data.session_id;
    $("score").textContent = data.score;
    $("intro").hidden = true;
    $("result").hidden = true;
    $("play").hidden = false;
    $("start-btn").disabled = false;
    renderStep(data.current);
  });


  $("submit-btn").addEventListener("click", async () => {
    let answer;
    try {
      answer = buildAnswer();
    } catch (e) {
      showFeedback(e.message, "bad");
      return;
    }

    // Chặn double-submit ở client; server vẫn có unique index làm lớp cuối (§9).
    $("submit-btn").disabled = true;
    try {
      const data = await api("/api/v1/sessions/" + sessionId + "/answers", {
        method: "POST",
        body: JSON.stringify({ position: step, answer, elapsed_ms: Date.now() - stepShownAt })
      });

      $("score").textContent = data.total_score;
      $("progress-bar").style.width = (step * 100 / totalSteps) + "%";
      showFeedback("+" + data.awarded_score + " điểm. " + (data.explanation || ""),
                   data.awarded_score > 0 ? "good" : "bad");

      // Giữ nguyên đáp án đã chọn và phần giải thích trên màn hình; chỉ sang câu tiếp
      // theo khi người chơi tự bấm nút, không tự động chuyển sau vài giây.
      pendingResult = data;
      lockAnswers();
      $("submit-btn").hidden = true;
      const next = $("next-btn");
      next.hidden = false;
      next.textContent = data.finished ? "Xem kết quả" : "Câu tiếp theo";
      next.focus();
    } catch (e) {
      if (e.status === 409) {
        showFeedback("Câu này đã được trả lời, đang tải lại trạng thái", "neutral");
        const data = await api("/api/v1/sessions/" + sessionId + "/current");
        renderStep(data.current);
      } else {
        showFeedback(e.body?.message || "Có lỗi xảy ra", "bad");
        $("submit-btn").disabled = false;
      }
    }
  });

  // Đáp án đã nộp thì không cho sửa nữa, nhưng vẫn hiển thị nguyên trạng để người chơi
  // đối chiếu với phần giải thích.
  function lockAnswers() {
    document.querySelectorAll("#answer-area input, #question input")
      .forEach((el) => { el.disabled = true; });
  }

  $("next-btn").addEventListener("click", () => {
    const data = pendingResult;
    if (!data) return;
    if (data.finished) {
      pendingResult = null;
      $("next-btn").hidden = true;
      $("submit-btn").hidden = false;
      finish(data.summary);
    } else {
      renderStep(data.next);
    }
  });

  function finish(summary) {
    $("result-score").textContent = summary.score + " / " + maxScore;
    $("result-text").textContent =
      "Điểm cao nhất của bạn: " + summary.personal_best +
      (summary.is_new_best ? " (kỷ lục mới)" : "") +
      ". Đây là lượt thứ " + summary.attempt_number + ".";
    $("play").hidden = true;
    $("result").hidden = false;
  }

  $("abandon-btn").addEventListener("click", async () => {
    const ok = await appDialog.confirm("Bỏ lượt này? Điểm sẽ không được tính.",
                                      { okLabel: "Bỏ lượt", danger: true });
    if (!ok) return;
    await api("/api/v1/sessions/" + sessionId + "/abandon", { method: "POST" });
    location.reload();
  });

  $("report-btn").addEventListener("click", async () => {
    const reason = await appDialog.prompt("Câu hỏi này sai ở đâu?",
                                         { title: "Báo câu hỏi sai" });
    if (!reason) return;
    try {
      await api("/api/v1/questions/" + questionId + "/reports", {
        method: "POST",
        body: JSON.stringify({ reason })
      });
      showFeedback("Đã gửi báo cáo, admin sẽ xem lại", "neutral");
    } catch (e) {
      showFeedback(e.body?.message || "Không gửi được báo cáo", "bad");
    }
  });

  $("replay-btn").addEventListener("click", () => location.reload());
</script>
