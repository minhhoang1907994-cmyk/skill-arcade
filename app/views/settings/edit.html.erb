<h1>Cài đặt</h1>

<div class="hero-row">
  <%= avatar_sprite(current_user.avatar, size: 64, css_class: "sprite--bounce") %>
  <div class="hero-row__bubble">
    Đây là hình đại diện của <%= current_user.display_name %>. Nó hiện ở đầu trang,
    ở trang chọn màn và cạnh tên bạn trên bảng xếp hạng.
  </div>
</div>

<div class="panel">
  <%# KHÔNG dùng class "form": nó cắt bề rộng còn 470px cho hợp ô nhập text, còn lưới hình
      cần cả bề rộng panel mới xếp được nhiều ô mỗi hàng. %>
  <%= form_with model: current_user, url: settings_path, method: :patch do |f| %>
    <% if current_user.errors.any? %>
      <ul class="errors">
        <% current_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%# Bọc riêng ô nhập tên trong .form để dùng lại giới hạn 470px và style label sẵn có —
        ô text kéo hết bề rộng panel thì rất khó nhắm. Lưới hình bên dưới nằm NGOÀI khối
        này nên vẫn giữ cả bề rộng panel. %>
    <div class="form">
      <div class="field">
        <%= f.label :display_name, "Tên hiển thị" %>
        <%# minlength/maxlength khớp validates length: { in: 2..50 } ở User — chặn ngay tại
            trình duyệt, còn validation ở model vẫn là lớp chốt. %>
        <%= f.text_field :display_name, required: true, minlength: 2, maxlength: 50 %>
        <p class="muted small">
          Tên này xuất hiện trên bảng xếp hạng, không được trùng người khác.
        </p>
      </div>
    </div>

    <%# Một fieldset duy nhất: mọi radio dùng cùng name user[avatar] nên chúng là MỘT nhóm
        lựa chọn, mũi tên bàn phím đi xuyên cả ba khối. Chia khối chỉ để mắt dễ tìm, vì vậy
        không đặt role="radiogroup" cho từng khối — làm vậy là khai sai cấu trúc cho
        screen reader. %>
    <fieldset class="avatar-picker">
      <legend class="panel__title">Chọn hình đại diện</legend>

      <% Avatar::GROUPS.each do |group_label, names| %>
        <p class="score-label"><%= group_label %></p>
        <div class="avatar-grid">
          <% names.each do |name| %>
            <label>
              <%= f.radio_button :avatar, name %>
              <%= pixel_sprite(name, size: 44) %>
              <span><%= sprite_label(name) %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    </fieldset>

    <%# Một nút Lưu cho cả tên và hình vì đây là MỘT form gửi cùng lúc — tách hai nút
        submit sẽ khiến người dùng tưởng phải lưu riêng từng phần. %>
    <div class="actions">
      <%= f.submit "Lưu", class: "btn--primary" %>
      <%= link_to "Về danh sách game", games_path, class: "btn" %>
    </div>
  <% end %>
</div>
