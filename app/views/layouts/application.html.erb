<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for(:title) || "Skill Arcade" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Skill Arcade">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Font pixel cho phần khung giao diện. Nếu không tải được (máy offline),
        CSS đã khai fallback sang monospace nên layout vẫn dùng bình thường. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <%# Item JRPG trang trí hai lề trang. Thuần thẩm mỹ nên aria-hidden, và CSS đặt
        pointer-events: none để không chắn thao tác. Tự ẩn khi màn hình hẹp. %>
    <div class="scenery" aria-hidden="true"><%= scenery_sprites %></div>

    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to logged_in? ? games_path : root_path, class: "site-header__brand",
              style: "display:flex; align-items:center; gap:10px" do %>
          <%= pixel_sprite(:hero, size: 34, css_class: "sprite--brand") %>
          <span>Skill Arcade</span>
        <% end %>

        <nav>
          <% if logged_in? %>
            <%= link_to "Game", games_path %>
          <% end %>
          <%= link_to "Bảng xếp hạng", leaderboards_path %>
          <%# Hướng dẫn để ngoài nhánh logged_in?: guest cần đọc được luật trước khi đăng ký. %>
          <%= link_to "Hướng dẫn", guide_path %>
          <% if current_user&.admin? %>
            <%= link_to "Tài khoản", admin_users_path %>
            <%= link_to "Báo cáo câu hỏi", admin_question_reports_path %>
          <% end %>
        </nav>

        <div class="site-header__spacer"></div>

        <% if logged_in? %>
          <%# Dùng <details> chứ không tự dựng dropdown bằng div + JS: trình duyệt lo sẵn
              trạng thái đóng/mở, Enter/Space trên summary, và aria-expanded. JS bên dưới
              chỉ thêm hai thứ <details> không có: đóng khi bấm ra ngoài và khi bấm Esc. %>
          <details class="user-menu">
            <summary class="site-header__user">
              <%= avatar_sprite(current_user.avatar, size: 26) %>
              <span><%= current_user.display_name %></span>
            </summary>
            <div class="user-menu__panel">
              <%= link_to "Cài đặt", settings_path, class: "user-menu__item" %>
              <%= button_to "Đăng xuất", session_path, method: :delete,
                    class: "user-menu__item user-menu__item--danger" %>
            </div>
          </details>
        <% else %>
          <nav>
            <%= link_to "Đăng nhập", login_path %>
            <%= link_to "Đăng ký", signup_path %>
          </nav>
        <% end %>
      </div>
    </header>

    <%# <details> không tự đóng khi bấm ra ngoài hay bấm Esc — hai hành vi người dùng
        mong đợi ở một dropdown. Chỉ bổ sung đúng hai thứ đó, phần còn lại để trình duyệt lo. %>
    <script>
      (function () {
        const menu = document.querySelector(".user-menu");
        if (!menu) return;

        document.addEventListener("click", (event) => {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          menu.open = false;
          menu.querySelector("summary").focus();
        });
      })();
    </script>

    <main>
      <% if flash[:notice] %>
        <div class="flash flash--notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash flash--alert"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </main>

    <%# Modal dialog dùng chung — thay alert/confirm/prompt của trình duyệt. Nạp ở layout
        để cả trang game và trang admin dùng cùng một hộp thoại. %>
    <%= render "shared/dialog" %>

    <%# Chính sách riêng tư phải có đường vào từ mọi trang, kể cả khi chưa đăng nhập (Q7). %>
    <footer class="site-footer">
      <%= link_to "Chính sách riêng tư", privacy_path %>
      <span>Skill Arcade — app luyện tập nội bộ v2.9</span>
    </footer>
  </body>
</html>
